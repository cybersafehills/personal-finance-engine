# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.
#
# Both values are SERVER-ONLY - neither is prefixed with NEXT_PUBLIC_, so
# Next.js never sends them to the browser. SUPABASE_SERVICE_ROLE_KEY in
# particular must stay server-only: it bypasses Row Level Security.

SUPABASE_URL=https://zttxsaiywkfrbdxgzbjd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The one canonical URL every Server Action builds links against
# (lib/site-url.ts) - signup confirmation, password reset, invites.
# Deliberately not derived from the request's origin, so a link is
# always correct regardless of which hostname the app happened to be
# reached through. Production must be the real domain, not the raw
# Vercel deployment URL.
SITE_URL=http://localhost:3417

# Resend (lib/resend.ts, lib/emails.ts) - server-only. Get your key from
# https://resend.com/api-keys and replace the placeholder below with it.
RESEND_API_KEY=re_xxxxxxxxx

# The "from" address for invite/security emails. Resend's sandbox sender
# (onboarding@resend.dev) only delivers to your own verified Resend
# account email - it silently fails for real invitees. Verify a domain
# in Resend (e.g. oneledger.me) and put an address on it here.
RESEND_FROM_EMAIL=notifications@oneledger.me
