# Copy to android/keystore.properties (git-ignored) for LOCAL signed release
# builds. In CI these come from GitHub secrets as environment variables instead
# — see docs/android-companion-release.md. All four are required to sign;
# absent ⇒ `assembleRelease` produces an unsigned APK.

ANDROID_KEYSTORE_FILE=/absolute/path/to/oneledger-companion-upload.jks
ANDROID_KEYSTORE_PASSWORD=changeme
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=changeme
