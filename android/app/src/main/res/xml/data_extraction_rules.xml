<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred off-device. The device credential lives in
  EncryptedSharedPreferences and the queue holds financial message text; neither
  should land in a cloud backup or a device-to-device transfer (ADR 0010 §3).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
