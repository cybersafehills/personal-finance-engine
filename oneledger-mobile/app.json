{
  "expo": {
    "name": "OneLedger",
    "slug": "oneledger",
    "scheme": "oneledger",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/ios-app-icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.oneledger.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/branding/ios-app-icon-1024.png"
    },
    "android": {
      "package": "me.oneledger.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android-adaptive-foreground-safe-1024.png",
        "monochromeImage": "./assets/branding/android-monochrome-safe-432.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "versionCode": 10,
      "icon": "./assets/branding/android-legacy-icon-1024.png",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow OneLedger to use Face ID to unlock the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OneLedger to use the camera to read a payment QR code. Nothing is photographed or saved.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow OneLedger to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/android-notification-96.png",
          "color": "#0050F4"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-logo-1024.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "OneLedger opens your contacts only when you tap the contact button, so you can pick one person to pay. It does not read or keep your address book."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6c66451a-7901-4f47-9f6d-05b73ebd96bb"
      }
    },
    "owner": "dolyindesign"
  }
}
