# Copy to .env.local (git-ignored) and fill in. These are PUBLIC values that
# are compiled into the app. Never put a service-role key or any secret here.

# Same values as the web app's NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the OneLedger web app that serves /api/mobile/* (no trailing
# slash). Production: the live site. Local development: http://localhost:3000
# with the web app started with MOBILE_API_ENABLED=true and
# MOBILE_API_CORS_ORIGINS=http://localhost:8081 (CORS is only needed for the
# browser preview, not for the phone app).
#
# Testing on a physical phone (Expo Go)? "localhost" is the phone itself, so
# sign-in fails with "Couldn't sign in. Check your connection". Use your
# computer's LAN address instead, e.g. http://192.168.1.10:3100, with the phone
# on the same Wi-Fi. Restart Expo with --clear after changing this value.
EXPO_PUBLIC_API_BASE_URL=

# iPhone setup uses the published links verified in the live web app.
# Usually leave these unset to use the app defaults. Override only when
# publishing replacements. An explicit empty value disables that link.
# EXPO_PUBLIC_MOMO_SHORTCUT_URL=https://www.icloud.com/shortcuts/...
# EXPO_PUBLIC_MOMO_CAPTURE_SHORTCUT_URL=https://www.icloud.com/shortcuts/...
