# Copy to .env.local (git-ignored) and fill in. These are PUBLIC values that
# are compiled into the app. Never put a service-role key or any secret here.

# Same values as the web app's NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the OneLedger web app that serves /api/mobile/* (no trailing
# slash). Production: the live site. Local development: http://localhost:3000
# with the web app started with MOBILE_API_ENABLED=true and
# MOBILE_API_CORS_ORIGINS=http://localhost:8081 (CORS is only needed for the
# browser preview, not for the phone app).
EXPO_PUBLIC_API_BASE_URL=
